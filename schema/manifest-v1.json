{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/p3ach96/VerdeVivo-Social-Content/blob/main/schema/manifest-v1.json",
  "title": "VerdeVivo Social Editorial Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "language", "publishAt", "image", "altText", "caption", "hashtags", "channels"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["draft", "approved"]},
    "language": {"const": "en"},
    "publishAt": {"type": "string", "format": "date-time"},
    "image": {"const": "social.png"},
    "altText": {"type": "string", "minLength": 1, "maxLength": 1500},
    "caption": {"type": "string", "minLength": 1, "maxLength": 5000},
    "hashtags": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^[\\p{L}\\p{N}_]{1,30}$"}},
    "channels": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["bluesky", "mastodon", "youtube"]}}
  }
}
